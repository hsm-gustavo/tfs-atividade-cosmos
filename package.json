{
  "name": "atividade-tfs-1",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "proto:gen": "protoc -I=src/proto --ts_out=src/proto --ts_opt=target=node src/proto/limites.proto",
    "build": "pnpm proto:gen && tsc -p tsconfig.json",
    "start:client": "node dist/index.js",
    "start:server1": "node dist/server.js",
    "start:server2": "node dist/server2.js",
    "start:server3": "node dist/server3.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/deasync": "^0.1.5",
    "@types/google-protobuf": "^3.15.12",
    "@types/node": "^25.9.1",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.3",
    "protoc-gen-ts": "^0.8.7",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.59.4"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.4",
    "deasync": "^0.1.31",
    "google-protobuf": "^3.21.4"
  }
}
